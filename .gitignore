# Local investigation scratch dirs — never commit
/scratch-repro/

# Generated SRAM backing for test ROMs (created at runtime, not a fixture)
tests/roms/*.sav

# Copyrighted GBA BIOS + GB boot ROMs — LLE/boot test fixtures, NEVER commit.
# These patterns are a safety net; the real files live outside the repo
# (~/Documents/emu/...) and are referenced by absolute path when running tests.
gba_bios.bin
*bios*.bin
*boot*.bin
dmg_rom.bin
cgb_boot.bin
dmg_boot.bin
*.boot.bin

# Claude Code local state
.claude/

# Windows cross-build output
dist/

# iOS build artifacts (built by ios/build-core.sh / xcodegen)
ios/lib/
ios/Dingbat.xcodeproj/
ios/build/
ios/DerivedData/
dingbat_dist

# Exploratory scratch harnesses (sources + compiled binaries) — never commit
scratch_*.nim
scratch_mp2kwav
scratch_probe
bench_freq
scratch_mp2k_boot
scratch_mc
dingbat_bench_hle
# compiled emulator binary emitted next to src/dingbat/gba/gba.nim
/src/dingbat/gba/gba
tools/romfuzz/dingbat_nav
tools/romfuzz/mgba_runner
tools/romfuzz/nba_runner
# built by tools/gbdiff/build.sh against a docboy checkout outside this repo
tools/gbdiff/docboy_gb_runner_dmg
tools/gbdiff/docboy_gb_runner_cgb
__pycache__/

# never commit ROM sweep artifacts (reports may reference ROM provenance; ROMs are copyrighted)
/romfuzz-report/
/roms/
/*.gba
/*.zip
/*.sav

# Runtime save written when the web demo ROM is played locally
web/*.sav

# Browser perf bench: ROMs/states are supplied locally (see web/bench/README.md)
web/bench/*.gba
web/bench/*.gb
web/bench/*.gbc
web/bench/*.state
web/bench/*.sav
dingbat_bench_d
dingbat_bench_orig

# Ad-hoc sweep binaries: building one harness per value of an intdefine is the
# standard way to measure a constant here (see tools/gbppu/cgbsweep.sh), and
# `git add -A` will happily commit two dozen 400 KB binaries if they are not
# ignored. That has happened once.
/dt_*
/dtr_*
web/*.gba
