@title Columns Crown (USA)
@file Columns Crown (U) [!].gba
@game ACGE
@chip EEPROM 4Kbit
@frozen dingbat-bios,mgba,nba

# First boot: the story intro (A through its pages), the two name screens
# (JADE and RUBY kept with START), then the title; the EEPROM keeps the
# names. Survival Mode, Easy, Jade, DOWN held until GAME OVER (no ranked
# score), NO at CONTINUE?, then Options > Rankings > Survival.
# [load]: with the names saved, START at the intro jumps to the title;
# START, Survival, Easy: the character screen with both names.
# Findings (docs/playtest-bugs.md §NEXT, Columns Crown): the boot's flash
# probe stores 0xFF, 0x90, 0xFF to 0x0DFFFFFE; dingbat takes them as EEPROM
# bits, sizes the chip from a stale DMA3 count as 64 Kbit and misparses
# every command after, so it writes 8 KB of scattered bytes and on [load]
# boots as if blank (and cannot read mgba's file either). mgba reads its
# save (title, then JADE/RUBY at the character select). The second
# reference writes the right bytes but also loses its save (ACGE missing
# from EEPROM_4K, §94), so the run PASSes on play and saves. Downstream,
# dingbat's first boot is shorter and its intro runs 46 frames ahead
# of mgba and 39 of the second reference: name_entry and mode_select SLIP
# (not diagnostic) and the audio fails (17.6%). All dingbat configurations
# agree.
[new]
wait 400
wait 300
wait 300
wait 600
press START
wait 120
press A
wait 60
press START
wait 60
tap START times=6 every=30 hold=4
wait 60
wait 300
wait 300
checkpoint intro_text window=30
press A
wait 200
wait 300
press A
wait 300
press A
wait 300
press A
wait 300
press A
wait 300
press A
wait 300
tap A times=10 every=250 hold=4
wait 100
checkpoint name_entry window=30
press START
wait 60
wait 120
press START
wait 180
checkpoint title window=30
press START
wait 90
wait 90
checkpoint mode_select window=30
press A
wait 126
press A
wait 186
press A
wait 186
checkpoint survival_start window=30
hold DOWN
wait 900
release
checkpoint game_over window=30
wait 240
press A
wait 180
press UP
wait 30
press A
wait 120
press DOWN
wait 20
press A
wait 90
press A
wait 120
wait 120
checkpoint rankings window=30

[load]
wait 700
wait 300
wait 600
press START
wait 120
wait 60
checkpoint continue_title window=30
press START
wait 180
checkpoint continue_modes window=30
press A
wait 126
press A
wait 186
wait 30
checkpoint continue_characters window=30
