@title Prince of Persia - The Sands of Time (USA)
@file Prince of Persia - The Sands of Time (U) (M3).gba
@game BPYE
@chip EEPROM
@frozen dingbat-bios,mgba,nba
@save skip: nothing reaches the EEPROM through the profile, the intro and the opening palace rooms (Quit from the pause menu goes back to START GAME with slot 1 still empty); the first save is further into the palace, past the climb out of the opening rooms

# English, START GAME, slot 1, name AAA, the intro text, the opening room;
# the pause menu (stats, items, the Continue/Sleep/Quit page), then the
# climb: the rope, the column beside it, a jump to the gold wall plate and
# up onto the shelf above the candle, and the drop back to the floor.
# The first boot formats 20 bytes of the 4 Kbit EEPROM; all three write
# the same 512-byte file.

[new]
wait 600
checkpoint language window=30
press A
wait 200
checkpoint main_menu window=30
press A
wait 200
checkpoint slots_empty window=30
press A
wait 200
press A after=30
press A after=30
checkpoint name_entry window=30
press A
wait 200
checkpoint intro_text window=30 compare=text
tap A times=6 every=40 hold=4
wait 120
tap A times=15 every=40 hold=4
wait 60
checkpoint first_room window=30
press START after=60
checkpoint pause_stats window=30
press R after=40
checkpoint pause_items window=30
press R after=40
press R after=40
press R after=40
checkpoint pause_quit_menu window=30
press A after=60
hold RIGHT
wait 120
release
hold RIGHT
wait 120
release
press UP hold=10 after=60
hold LEFT
wait 240
release
hold RIGHT
wait 75
release
wait 20
hold RIGHT
wait 60
release
wait 20
hold RIGHT
wait 22
release
wait 20
press A hold=10 after=50
hold UP
wait 180
release
hold RIGHT
wait 4
press RIGHT+A hold=10 after=60
release
hold UP
wait 150
release
press RIGHT+A hold=10 after=60
press RIGHT+A hold=10 after=60
wait 40
press UP+A hold=10 after=40
wait 30
checkpoint on_shelf window=30
hold RIGHT
wait 90
release
wait 20
checkpoint candle_room window=30

