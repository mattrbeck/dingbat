@title Metroid - Zero Mission (USA)
@file Metroid - Zero Mission (U) [!].gba
@game BMXE
@chip SRAM
@frozen dingbat-bios,mgba
# New file A on Normal: left over the rock to the Morph Ball, back right
# rolling under the rocks, through the breakable-block room and the Skree
# corridor, morph into the Chozo statue's hand (map hint, energy refill), then
# the shaft and the first Save Room; Yes, "Save Complete".
# Recorded without nba: in the authoring session nba drew a Zoomer at a
# different place from f2715 (dingbat-bios and mgba agree), its kill drop gave
# 99 energy instead of 84 around f3300, and by f4968 an extra Zoomer had
# knocked Samus back, so the session went on without it. (The replay with
# nba still reaches the save: morph_ball differs MAJOR on nba, energy 99.)

[new]
wait 600
press START
# until text 'ZERO MISSI' timeout=600 every=10  [reached dingbat-bios+10 mgba+10]
wait 14
wait 60
checkpoint title window=30
press START
# until text 'SAMUS DATA' timeout=600 every=10  [reached dingbat-bios+90 mgba+90]
wait 94
wait 60
checkpoint samus_data window=30
press A
# until text 'Start Game' timeout=300 every=5  [reached dingbat-bios+20 mgba+20]
wait 24
wait 60
press A
# until text Difficulty timeout=300 every=5  [reached dingbat-bios+10 mgba+10]
wait 14
wait 30
checkpoint difficulty window=30
press A
# until text 'Planet Zebes' timeout=900 every=10  [reached dingbat-bios+470 mgba+470]
wait 474
# mash A until notext Zebes timeout=1200 every=20  [taps dingbat-bios:15 mgba:15]
