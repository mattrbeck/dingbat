@title Super Mario Advance (USA)
@file Super Mario Advance (U) [!].gba
@game AMZE
@chip EEPROM 4Kbit
@frozen dingbat-bios,mgba,nba

# Super Mario 2, File A as Mario, pause in 1-1 and SAVE AND QUIT; the
# title then leads back to a file select whose File A reads WORLD 1-1.
[new]
wait 600
press START
# until text 'Single Player' timeout=600 every=10  [reached dingbat-bios+0 mgba+0 nba+0]
wait 4
checkpoint title window=30
press A
# until text 'Choose a Game' timeout=600 every=10  [reached dingbat-bios+90 mgba+90 nba+100]
wait 104
wait 60
press A hold=10
# until text ERASE timeout=600 every=10  [reached dingbat-bios+170 mgba+170 nba+170]
wait 174
wait 60
checkpoint file_select window=30
press A
# until text 'CHOOSE A PLAYER' timeout=600 every=10  [reached dingbat-bios+110 mgba+110 nba+110]
wait 114
wait 60
checkpoint player_select window=30
press A hold=10
# until notext 'CHOOSE A PLAYER' timeout=600 every=10  [reached dingbat-bios+80 mgba+80 nba+80]
wait 84
wait 600
# mash START until text PAUSE timeout=900 every=60  [taps dingbat-bios:1 mgba:1 nba:1]
tap START times=1 every=60 hold=4
wait 20
checkpoint paused window=30
press DOWN after=20
press DOWN after=20
press A after=30
# until text 'Single Player' timeout=900 every=10  [reached dingbat-bios+60 mgba+60 nba+60]
wait 64
checkpoint quit_to_title window=30
press A
# until text 'Choose a Game' timeout=600 every=10  [reached dingbat-bios+90 mgba+90 nba+100]
wait 104
wait 60
press A hold=10
# until text ERASE timeout=600 every=10  [reached dingbat-bios+170 mgba+170 nba+170]
wait 174
wait 60
checkpoint saved window=10

[load]
wait 600
press START
# until text 'Single Player' timeout=600 every=10  [reached dingbat-bios+0 mgba+0 nba+0]
wait 4
press A
# until text 'Choose a Game' timeout=600 every=10  [reached dingbat-bios+90 mgba+90 nba+100]
wait 104
wait 60
press A hold=10
# until text ERASE timeout=600 every=10  [reached dingbat-bios+170 mgba+170 nba+170]
wait 174
wait 60
checkpoint file_select_loaded window=10
press A
# until text 'CHOOSE A PLAYER' timeout=600 every=10  [reached dingbat-bios+110 mgba+110 nba+110]
wait 114
wait 60
press A hold=10
# until notext 'CHOOSE A PLAYER' timeout=600 every=10  [reached dingbat-bios+80 mgba+80 nba+80]
wait 84
wait 600
# mash START until text PAUSE timeout=900 every=60  [taps dingbat-bios:1 mgba:1 nba:1]
tap START times=1 every=60 hold=4
wait 20
checkpoint resumed_paused window=30
