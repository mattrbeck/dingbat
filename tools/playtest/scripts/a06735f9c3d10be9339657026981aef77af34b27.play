@title Yu-Gi-Oh! The Sacred Cards (USA)
@file Yu-Gi-Oh! - The Sacred Cards (U) [!].gba
@game AY8E
@chip SRAM (ROM also names SRAM_F)
@frozen dingbat-bios,mgba,nba

# New game named "A", tap through Joey's wake-up dialog, walk to the PC on
# the desk and save. [load] continues from the title, lands in the bedroom
# (no Joey) and opens Status, which shows the name A.
[new]
wait 600
# until text 1996 timeout=2400 every=30  [reached dingbat-bios+60 mgba+60 nba+60]
wait 64
wait 60
checkpoint title window=30
press A hold=10
# until text OK timeout=600 every=10  [reached dingbat-bios+90 mgba+90 nba+90]
wait 94
wait 60
checkpoint name_entry window=30
press A hold=10 after=60
press START hold=10 after=60
press A hold=10
# until blank timeout=600 every=5  [reached dingbat-bios+135 mgba+135 nba+135]
wait 139
# until notblank timeout=900 every=10  [reached dingbat-bios+40 mgba+40 nba+40]
wait 44
# until text Tournament timeout=1200 every=10  [reached dingbat-bios+290 mgba+290 nba+300]
wait 304
wait 30
checkpoint joey_arrives window=0
# mash A until text morning timeout=600 every=60  [taps dingbat-bios:1 mgba:1 nba:1]
tap A times=1 every=60 hold=4
wait 30
checkpoint joey window=30
press A after=36
press A after=36
press A after=36
press A after=36
press A after=36
press A after=36
press A after=36
press A after=36
press A after=36
press A after=36
press A after=36
press A after=36
press A after=36
press A after=36
press A after=36
press A after=36
press A after=36
press A after=36
press A after=36
press A after=36
press A after=36
press A after=36
press A after=36
press A after=36
wait 120
checkpoint room window=10
press UP hold=20 after=30
press LEFT hold=20 after=30
press RIGHT hold=20 after=20
press UP hold=30 after=20
press A after=30
# until text save timeout=300 every=10  [reached dingbat-bios+0 mgba+0 nba+0]
wait 4
wait 30
checkpoint save_prompt window=0
press A
# until text completed timeout=600 every=5  [reached dingbat-bios+20 mgba+20 nba+20]
wait 24
wait 30
checkpoint saved window=0

[load]
wait 600
# until text 1996 timeout=2400 every=30  [reached dingbat-bios+60 mgba+60 nba+60]
wait 64
wait 60
checkpoint title_continue window=10
press A hold=10
# until blank timeout=600 every=5  [reached dingbat-bios+60 mgba+60 nba+60]
wait 64
# until notblank timeout=900 every=10  [reached dingbat-bios+10 mgba+10 nba+10]
wait 14
wait 120
checkpoint resumed window=10
press SELECT hold=10
# until text Trunk timeout=300 every=10  [reached dingbat-bios+10 mgba+10 nba+10]
wait 14
wait 30
press A hold=10
# until text Money timeout=300 every=10  [reached dingbat-bios+0 mgba+0 nba+0]
wait 4
wait 60
checkpoint status window=10
