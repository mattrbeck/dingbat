@title Super Mario Advance 4 - Super Mario Bros. 3 (USA)
@file Super Mario Advance 4 - Super Mario Bros. 3 (U) (V1.1).gba
@game AX4E
@chip FLASH1M
@frozen dingbat-bios,mgba,nba

# Single player, File 1, one Mario. On the World 1 map open the START menu
# and "save & quit" (a save the game says can be continued once), which
# returns to the title screen. START is ignored on the SMB3 title until its
# intro has run, so the route waits it out rather than mashing.

[new]
wait 400
wait 600
press START
wait 120
press A
wait 90
press START
wait 120
press UP
wait 30
press A
wait 150
wait 600
press START hold=8
# mash START until text File timeout=3000 every=40 hold=8  [taps dingbat-bios:2 mgba:2 nba:2]
tap START times=2 every=40 hold=8
wait 30
checkpoint file_select_empty window=0
press A
# until text Mode timeout=600 every=10  [reached dingbat-bios+0 mgba+0 nba+0]
wait 4
wait 30
checkpoint player_select window=0
press A
# until text WORLD timeout=900 every=10  [reached dingbat-bios+70 mgba+70 nba+70]
wait 74
wait 300
checkpoint world_map window=0
press START
# until text continue timeout=120 every=5  [reached dingbat-bios+10 mgba+10 nba+10]
wait 14
wait 30
press DOWN after=20
checkpoint map_menu window=0
press A
# until text 'title screen' timeout=300 every=5  [reached dingbat-bios+15 mgba+15 nba+20]
wait 24
wait 30
press LEFT after=20
checkpoint quit_prompt window=0
press A
# until notext 'title screen' timeout=300 every=5  [reached dingbat-bios+0 mgba+0 nba+0]
wait 4
wait 600
checkpoint saved window=0

[load]
wait 1000
press START
wait 120
press A
wait 90
press START
wait 120
press UP
wait 30
press A
wait 750
press START hold=8
# mash START until text File timeout=3000 every=40 hold=8  [taps dingbat-bios:2 mgba:2 nba:2]
tap START times=2 every=40 hold=8
wait 30
checkpoint file_select_saved window=0
press A
# until text Mode timeout=600 every=10  [reached dingbat-bios+100 mgba+100 nba+100]
wait 104
wait 30
press A
# until text WORLD timeout=900 every=10  [reached dingbat-bios+80 mgba+100 nba+80]
wait 104
# until notext MARIO timeout=900 every=10  [reached dingbat-bios+110 mgba+110 nba+110]
wait 114
wait 60
checkpoint resumed window=0
press START
# until text continue timeout=300 every=5  [reached dingbat-bios+10 mgba+10 nba+10]
wait 14
wait 30
checkpoint resumed_menu window=0

