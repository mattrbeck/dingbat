@title Spyro - Season of Ice (USA)
@file Spyro - Season of Ice (U) [!].gba
@game ASYE
@chip EEPROM 4Kbit
@frozen dingbat-bios,mgba,nba
@save skip: the first progress save is past this route (after a level, beyond the hub); quitting writes only the settings (5 bytes) and Continue Game stays disabled
# New game, skip the intro, walk the first hub, break a jar for gems (4/7000), pause and open the Atlas.
# Picked for its anti-copy protection, which sabotages gem collection when it takes the cart for a copy (a save chip it does not expect): the gem count has to climb in every emulator.

[new]
wait 600
tap START times=16 every=30 hold=4
checkpoint title window=30
press START
wait 120
checkpoint main_menu window=30
press A
wait 480
checkpoint intro_story window=30
tap A times=30 every=40 hold=4
wait 200
press START
wait 240
checkpoint first_gameplay window=30
hold UP
wait 150
release
checkpoint glide window=30
wait 120
hold RIGHT
wait 120
release
hold DOWN
wait 120
release
hold LEFT
wait 120
release
checkpoint hub_walk window=30
hold DOWN+RIGHT
wait 180
release
press B
wait 60
hold UP+RIGHT
wait 180
release
hold LEFT
wait 70
release
tap B times=4 every=30 hold=4
hold LEFT
wait 40
release
wait 120
press START
wait 60
checkpoint pause_gems window=30
press DOWN
wait 20
press A
wait 120
checkpoint atlas_totals window=30
