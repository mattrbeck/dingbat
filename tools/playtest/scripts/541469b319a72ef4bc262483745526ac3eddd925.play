wait 34
wait 60
checkpoint resumed window=30
tap A times=4 every=40 hold=4
press DOWN hold=60
wait 30
press RIGHT hold=60
wait 30
wait 60
press RIGHT hold=40
press UP hold=40
wait 60
checkpoint walking window=30

