@title Pokemon Emerald Version (USA, Europe)
@file Pokemon - Emerald Version (U).gba
@game BPEE
@chip FLASH1M + RTC
@frozen dingbat-bios,mgba,nba

# New game as a boy named AA, straight to the moving truck, save there.
[new]
wait 900
press START
# until text 'PRESS START' timeout=1200 every=10  [reached dingbat-bios+620 mgba+560 nba+530]
wait 624
checkpoint title window=30
press START
# until text 'NEW GAME' timeout=600 every=10  [reached dingbat-bios+80 mgba+80 nba+80]
wait 84
# until stable 20 timeout=300 every=4  [reached dingbat-bios+20 mgba+20 nba+20]
wait 24
checkpoint main_menu window=30
press A
# until text waiting timeout=1200 every=10  [reached dingbat-bios+670 mgba+670 nba+670]
wait 674
checkpoint birch window=30
# mash A until text GIRL timeout=3000 every=20  [taps dingbat-bios:105 mgba:105 nba:105]
tap A times=105 every=20 hold=4
# until stable 10 timeout=200 every=4  [reached dingbat-bios+10 mgba+10 nba+10]
wait 14
checkpoint gender window=30
press A
# mash A until text name timeout=600 every=20  [taps dingbat-bios:4 mgba:4 nba:4]
tap A times=4 every=20 hold=4
wait 90
press A
# until text BACK timeout=600 every=10  [reached dingbat-bios+50 mgba+50 nba+50]
wait 54
wait 60
checkpoint naming window=30
press A after=20
press A after=20
press START after=20
press A after=60
# until text YES timeout=300 every=5  [reached dingbat-bios+20 mgba+20 nba+20]
wait 24
press A after=10
# mash A until blank timeout=3000 every=20  [taps dingbat-bios:61 mgba:60 nba:61]
tap A times=61 every=20 hold=4
# until notblank timeout=1200 every=10  [reached dingbat-bios+230 mgba+230 nba+230]
wait 234
wait 800
press RIGHT hold=40 after=60
checkpoint truck window=30
press START
# until text SAVE timeout=120 every=5  [reached dingbat-bios+5 mgba+5 nba+5]
wait 9
wait 10
# mash DOWN until selected SAVE timeout=200 every=10  [taps dingbat-bios:2 mgba:2 nba:2]
tap DOWN times=2 every=10 hold=4
checkpoint start_menu window=30
press A
# until text YES timeout=300 every=5  [reached dingbat-bios+130 mgba+130 nba+135]
wait 139
wait 10
checkpoint save_prompt window=10
press A
# until text 'saved the game' timeout=900 every=5  [reached dingbat-bios+360 mgba+430 nba+365]
wait 434
checkpoint saved window=0

[load]
wait 900
press START
# until text 'PRESS START' timeout=1200 every=10  [reached dingbat-bios+620 mgba+560 nba+530]
wait 624
press START
# until text CONTINUE timeout=600 every=10  [reached dingbat-bios+80 mgba+80 nba+80]
wait 84
# until stable 20 timeout=300 every=4  [reached dingbat-bios+20 mgba+20 nba+20]
wait 24
checkpoint continue_menu window=30
press A
# until notblank timeout=600 every=10  [reached dingbat-bios+0 mgba+0 nba+0]
wait 4
# until stable 30 timeout=900 every=4  [reached dingbat-bios+90 mgba+90 nba+90]
wait 94
checkpoint resumed window=30
press START
# until text SAVE timeout=120 every=5  [reached dingbat-bios+5 mgba+5 nba+5]
wait 9
wait 10
checkpoint resumed_menu window=30
