@title Tom Clancy's Splinter Cell (USA)
@file Tom Clancy's Splinter Cell (U) (M3).gba
@game AO4E
@chip EEPROM (EEPROM_V122; a 4 Kbit chip, dingbat and mgba write 512 bytes)
@frozen dingbat-bios,mgba,nba

# Logos and intro (START at f1800), title with the language flags, A
# (English) > SELECT GAME > profile slot 1, name "BAA" (UP on the first
# letter); the profile is written to the EEPROM as the mission select
# opens. T'Bilisi's briefing, the street, Lambert on the codec, START opens
# the inventory. [load]: SELECT GAME lists "BAA" in slot 1 (the portrait
# is the last mission's), its mission select (the first A there is not
# taken), the briefing and the street again.
# The intro's scrolling digits, the title's scanline glitch and the
# equaliser on the menus draw from the game's own randomness and differ
# between all three emulators; menus are compared by text.
# When authored the second reference wrote an 8 KB file and its
# [load] showed an empty slot 1; AO4E is in emu.py's EEPROM_4K since (§94).
[new]
wait 270
checkpoint ubisoft window=30
wait 1140
checkpoint intro_lights window=30
wait 270
press START
wait 210
checkpoint title window=30
press A
wait 120
checkpoint main_menu window=30 compare=text
press A
wait 120
checkpoint profiles window=30 compare=text
press A
wait 120
press UP
wait 20
press A
wait 20
checkpoint name_entry window=30 compare=text
press A
wait 20
press A
wait 90
checkpoint mission_select window=30 compare=text
press A
wait 420
checkpoint briefing window=30
press A
wait 240
checkpoint tbilisi_start window=30
hold RIGHT
wait 180
release
wait 30
checkpoint codec window=30
press START
wait 60
checkpoint inventory window=30 compare=text

[load]
wait 1800
press START
wait 210
press A
wait 120
press A
wait 120
checkpoint profiles window=30 compare=text
press A
wait 120
checkpoint mission_select window=30 compare=text
press A
wait 420
wait 60
press A
wait 240
checkpoint briefing window=30
press A
wait 240
checkpoint tbilisi_start window=30

