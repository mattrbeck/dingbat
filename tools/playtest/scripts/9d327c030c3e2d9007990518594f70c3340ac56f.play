@title Mario Kart Super Circuit (USA)
@file Mario Kart Super Circuit (U) [!].gba
@game AMKE
@chip FLASH (512K)
@frozen dingbat-bios,mgba,nba
@save skip: the game writes nothing to flash through the menus; the first save needs a finished race (records are written at the finish of a 3-lap time trial). Driving it by screenshots was too slow: the first lap's hairpin, S-bend and U-turn took most of the budget and the kart ends on the grass at the U-turn of lap 1

# Title -> 1P -> TIME TRIAL -> TRIAL -> default character (Peach) ->
# Mushroom Cup -> Peach Circuit -> OK? -> start line; A is held from the green
# light (holding it through the countdown burns out), steering pulses through
# the top hairpin, the S-bend (cutting the grass past a tree) and into the
# U-turn.
# nba's race timer runs one to two hundredths behind dingbat-bios and mgba
# from the start (0'02"33 vs 0'02"35 at f2991), and around f3259 nba's kart
# brushes the tree at a different angle than the other two.

[new]
wait 600
press START
# until text 'SINGLE PLAYER' timeout=600 every=10  [reached dingbat-bios+20 mgba+10 nba+20]
wait 24
wait 130
checkpoint title window=30
press START
# until text CHOOSE timeout=300 every=5  [reached dingbat-bios+115 mgba+105 nba+110]
wait 119
wait 60
checkpoint game_select window=30
press DOWN after=30
press A
# until text RECORDS timeout=300 every=5  [reached dingbat-bios+50 mgba+50 nba+50]
wait 54
wait 60
press A
# until text CHARACTER timeout=300 every=5  [reached dingbat-bios+140 mgba+130 nba+130]
wait 144
wait 60
checkpoint character_select window=30
press A after=60
press A after=150
checkpoint cup_select window=30
press A
# until text PEACH timeout=300 every=5  [reached dingbat-bios+5 mgba+5 nba+10]
wait 14
wait 30
press A after=90
checkpoint track window=30
press A after=320
checkpoint ok_prompt window=30
press A after=300
checkpoint start_line window=0
wait 180
hold A
wait 90
wait 25
hold A+LEFT
wait 25
hold A
hold A+LEFT
wait 45
hold A
hold A+LEFT
wait 40
hold A
hold A+RIGHT
wait 60
hold A
checkpoint hairpin window=0
wait 15
hold A+LEFT
wait 40
hold A
wait 8
wait 10
wait 12
hold A+RIGHT
wait 6
hold A
wait 12
hold A+RIGHT
wait 12
hold A
wait 8
wait 15
hold A+LEFT
wait 22
hold A
wait 8
hold A+LEFT
wait 10
hold A
wait 10
hold A+LEFT
wait 20
hold A
wait 5
hold A
wait 60
release
checkpoint driving window=0 compare=none

