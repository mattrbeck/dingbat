@title Final Fantasy IV Advance (USA)
@file Final Fantasy IV Advance (U).gba
@game BZ4E
@chip SRAM
@frozen dingbat-bios,mgba,nba

# New Game, the Red Wings opening and the Baron audience (A every 60 frames),
# then free in the castle at night: down to 1F, west stairs to the rampart,
# west tower (Rosa), the NW courtyard (Cid), West Tower 1F/2F (the maid moves
# off the stairs after talking to her), Cecil's Chamber, into the bed; the
# night scene, the prologue crawl (no input: A there skips to the title) and
# the world map outside Baron with Kain. Save to slot 1 from the menu.
# Cutscene walks run at slightly different speeds on the three emulators:
# the "okay" mash is mgba's count (138 taps), dingbat-bios and nba had already
# left that box; the screens converge at every later text box. mgba's
# animated water / clouds / menu gradient often differ by a frame or two.

[new]
wait 600
press A
# mash START until text Game timeout=3000 every=40  [taps dingbat-bios:16 mgba:15 nba:16]
tap START times=16 every=40 hold=4
wait 60
checkpoint title window=0
press A hold=10
# until text 'Baron shortly' timeout=4000 every=10  [reached dingbat-bios+1800 mgba+1710 nba+1800]
wait 1804
wait 30
checkpoint deck window=30 compare=text
# mash A until text okay timeout=6000 every=40  [taps dingbat-bios:137 mgba:138 nba:137]
tap A times=138 every=40 hold=4
wait 60
press A
wait 120
press A
wait 100
press A
wait 100
press A
wait 100
press A
wait 100
press A
wait 100
press A
wait 100
press A
wait 100
press A
wait 100
wait 600
wait 600
wait 600
wait 300
tap A times=8 every=60 hold=6
tap A times=8 every=60 hold=6
