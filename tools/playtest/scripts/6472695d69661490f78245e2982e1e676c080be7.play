@title Final Fantasy I & II - Dawn of Souls (USA)
@file Final Fantasy I & II - Dawn of Souls (U).gba
@game BFFE
@chip SRAM
@frozen dingbat-bios,mgba,nba

# Title Select > FINAL FANTASY > New Game; keep the default classes (Warrior,
# Thief, White Mage, Black Mage) and name each one "A" by hand (SELECT's
# Auto-Name is random and picks different names in mGBA). START skips the
# prologue to the world map outside Cornelia; the menu's Save writes File 1.
# [load]: Load Game shows File 1 (four A's, Cornelia, 500 Gil) and resumes
# on the world map.
[new]
wait 600
# until stable 30 timeout=900 every=4  [reached dingbat-bios+300 mgba+300 nba+300]
wait 304
checkpoint title window=10
press START after=120
press START after=120
# until text 'Title Select' timeout=600 every=10  [reached dingbat-bios+0 mgba+0 nba+0]
wait 4
wait 20
checkpoint title_select window=10
press A after=120
# until text SQUARE timeout=900 every=10  [reached dingbat-bios+190 mgba+190 nba+190]
wait 194
wait 60
checkpoint ff1_title window=0 compare=text
press START
wait 120
checkpoint new_game window=10
press A
# until text Confirm timeout=600 every=10  [reached dingbat-bios+50 mgba+50 nba+50]
wait 54
wait 20
checkpoint party window=10
press RIGHT after=20
press A
# until text 'Enter name' timeout=300 every=5  [reached dingbat-bios+15 mgba+15 nba+15]
wait 19
wait 20
press A after=20
press START after=60
press DOWN after=20
press A
# until text 'Enter name' timeout=300 every=5  [reached dingbat-bios+0 mgba+0 nba+0]
wait 4
wait 20
press A after=20
press START after=60
press DOWN after=20
press A
# until text 'Enter name' timeout=300 every=5  [reached dingbat-bios+15 mgba+10 nba+15]
wait 19
wait 20
press A after=20
press START after=60
press DOWN after=20
press A
# until text 'Enter name' timeout=300 every=5  [reached dingbat-bios+0 mgba+0 nba+0]
wait 4
wait 20
press A after=20
press START after=60
checkpoint party_named window=10
press START
# until text 'Begin game' timeout=300 every=5  [reached dingbat-bios+0 mgba+0 nba+0]
wait 4
wait 30
press A
# until blank timeout=600 every=4  [reached dingbat-bios+28 mgba+28 nba+28]
wait 32
# until notblank timeout=900 every=4  [reached dingbat-bios+8 mgba+8 nba+8]
wait 12
# until text darkness timeout=900 every=10  [reached dingbat-bios+290 mgba+300 nba+300]
wait 304
wait 30
checkpoint prologue window=0 compare=text
press START after=120
checkpoint world_map window=10
press START
# until text Formation timeout=300 every=5  [reached dingbat-bios+25 mgba+25 nba+25]
wait 29
wait 30
checkpoint menu window=10
press UP after=20
press A
# until text Empty timeout=300 every=5  [reached dingbat-bios+5 mgba+5 nba+5]
wait 9
wait 30
checkpoint save_files window=10
press A
# until text Cornelia timeout=300 every=5  [reached dingbat-bios+5 mgba+5 nba+5]
wait 9
wait 30
checkpoint saved window=10

[load]
wait 600
# until stable 30 timeout=900 every=4  [reached dingbat-bios+300 mgba+300 nba+300]
wait 304
press START after=120
press START after=120
# until text 'Title Select' timeout=600 every=10  [reached dingbat-bios+0 mgba+0 nba+0]
wait 4
wait 20
press A after=120
# until text SQUARE timeout=900 every=10  [reached dingbat-bios+190 mgba+190 nba+190]
wait 194
wait 60
press START
wait 120
checkpoint load_menu window=10
press A
# until text 'Select file to load' timeout=300 every=5  [reached dingbat-bios+45 mgba+45 nba+45]
wait 49
wait 30
checkpoint load_files window=10
press A
# until blank timeout=300 every=2  [reached dingbat-bios+30 mgba+30 nba+32]
wait 36
# until notblank timeout=600 every=4  [reached dingbat-bios+12 mgba+12 nba+12]
wait 16
wait 120
checkpoint resumed_world_map window=10
press START
# until text Formation timeout=300 every=5  [reached dingbat-bios+25 mgba+25 nba+25]
wait 29
wait 30
checkpoint resumed_menu window=10
