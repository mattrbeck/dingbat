@title Mario Party Advance (USA)
@file Mario Party Advance (U).gba
@game B8ME
@chip EEPROM
@frozen dingbat-bios,mgba,nba

# A blank cart formats itself ("Saving..." right after the Hudson logo), then
# the host has the player fill in a profile: name, birth month JAN, hobby,
# comment, dream and secret. Each keyboard ignores keys for a while after it
# appears, and that delay differs between emulators, so every field is filled
# to its maximum length with a fixed run of A taps (taps on a full field do
# nothing) instead of typing a few letters. The game saves the profile
# ("Saving...") and drops into Shroom City. [load] boots straight to "Welcome
# to Party World" instead of the new-game profile interview.
[new]
# until text 'Press any button' timeout=900 every=10  [reached dingbat-bios+140 mgba+140 nba+140]
wait 144
checkpoint health window=10
press A
# until text HUDSON timeout=600 every=10  [reached dingbat-bios+170 mgba+160 nba+160]
wait 174
press START after=20
# until text Saving timeout=900 every=10  [reached dingbat-bios+110 mgba+100 nba+110]
wait 114
checkpoint format_saving window=0 compare=text
# until notext Saving timeout=1200 every=10  [reached dingbat-bios+0 mgba+10 nba+0]
wait 14
# until text there timeout=600 every=10  [reached dingbat-bios+460 mgba+480 nba+440]
wait 484
# mash A until text 'you should' timeout=3000 every=30  [taps dingbat-bios:31 mgba:31 nba:31]
tap A times=31 every=30 hold=4
press A after=8
press A after=8
