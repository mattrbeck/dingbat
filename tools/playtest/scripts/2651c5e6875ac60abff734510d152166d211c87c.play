@title Shin Bokura no Taiyou: Gyakushuu no Sabata (Japan)
@file Shin Bokura no Taiyou - Gyakushuu no Sabata (J).gba
@game U33J
@chip EEPROM + RTC + solar sensor
@frozen dingbat-bios,mgba,nba

# Japanese text: OCR reads none of it, so the route was found from
# screenshots and is fixed waits and A taps.
# First boot: solar sensor notice, sensor calibration (A with the sensor
# dark), clock setting (START = おわり), region (かんとう 2 / トウキョウ), Konami,
# caution screen, title. GAME START / 最初からはじめる, no Boktai 2 password
# (いいえ), keep the name ジャンゴ (START jumps to おわり). Long auto-scrolling
# prologue, A through Sabata's dialogue, then a prologue boss fight that
# needs no input: the boss cannot be hurt and the fight ends in a cutscene
# (standing still survives it on all three here). A through the cutscenes,
# the title card and Otenko's tutorial to the first room (閉ざされた牢獄 B4F);
# the pause menu has a セーブ tab (START, R x7 wraps to the map, L back):
# はい, "セーブしています。" for ~330 frames, "セーブしました。".
# [load]: the title leads straight to GAME START with the file (00:04,
# LV.01, B4F); continuing replays Otenko's talk and resumes in the same room.
# Seen while authoring:
# - solar_notice (f400): mgba reaches the notice's sun animation 8 frames
#   before dingbat and nba (f169 against f177), SLIP: the boot's soft-float
#   and EWRAM loading code from ROM is cheaper in mgba than the bus allows.
#   nba used to look identical to mgba there only because it ran on the host
#   clock, which shortens the boot's clock-dependent work; with its driver
#   honouring --rtc it matches dingbat frame for frame (docs/playtest-bugs.md,
#   "Shin Bokura no Taiyou: the sensor notice"). All converge on the
#   sensor-setting screen.
# - Saves: the dingbat configurations write identical files; against nba
#   12 bytes differ (plus dingbat's 16-byte RTC trailer), against mgba 4511;
#   every save loads in every emulator.
# - The white flash before the prologue fight (~f10120) lasts a different
#   time on each emulator and differs between sessions too (this route: mgba
#   leaves it ~50 frames before dingbat-bios and nba; an earlier route: mgba,
#   nba +15, dingbat-bios +60), so the fight plays out of phase on all three
#   (boss and player positions differ) and the following dialogue boxes
#   advance on different A taps; all three are back on the same screens by
#   the title card (f21082). In an earlier route mgba lost this fight
#   (GAME OVER at f12812); in this one all three survive.
[new]
wait 400
checkpoint solar_notice window=30
wait 260
checkpoint sensor_setting window=30
press A
wait 120
wait 60
press START
wait 240
wait 60
press A
wait 1100
# until text 'PUSH START' timeout=1500 every=10  [reached dingbat-bios+10 mgba+10 nba+10]
wait 14
wait 20
checkpoint title window=10
press START hold=10
wait 120
press A hold=10
wait 120
wait 60
press A hold=10
wait 120
wait 60
press A hold=10
wait 120
checkpoint player_name window=30
press START hold=10
wait 30
press A hold=10
wait 120
wait 4300
# mash A until blank timeout=3000 every=40 hold=6  (the white flash before the fight)  [taps dingbat-bios:62 mgba:60 nba:62]
tap A times=62 every=40 hold=6
# the prologue fight: no input
wait 1700
wait 600
wait 600
tap A times=10 every=40 hold=6
wait 30
tap A times=20 every=40 hold=6
wait 30
tap A times=30 every=40 hold=6
wait 30
tap A times=30 every=40 hold=6
wait 30
tap A times=30 every=40 hold=6
wait 30
tap A times=15 every=40 hold=6
wait 30
tap A times=15 every=40 hold=6
wait 30
tap A times=15 every=40 hold=6
wait 30
tap A times=15 every=40 hold=6
wait 30
tap A times=15 every=40 hold=6
wait 30
wait 300
wait 300
tap A times=20 every=40 hold=6
wait 30
tap A times=10 every=40 hold=6
wait 30
tap A times=15 every=40 hold=6
wait 30
tap A times=15 every=40 hold=6
wait 30
checkpoint first_gameplay window=30
press START hold=10
wait 60
press R
wait 40
press R
wait 40
press R
wait 40
press R
wait 40
press R
wait 40
press R
wait 40
press R
wait 40
press L
wait 40
checkpoint save_menu window=10
press A
wait 30
press A
wait 10
wait 30
wait 60
wait 120
checkpoint saving window=0
# until changed timeout=3000 every=5  [reached dingbat-bios+110 mgba+105 nba+110]
wait 114
wait 20
checkpoint saved window=10

[load]
wait 600
# until text 'PUSH START' timeout=3000 every=10  [reached dingbat-bios+470 mgba+460 nba+460]
wait 474
wait 20
checkpoint title window=10
press START hold=10
wait 120
press A hold=10
wait 120
checkpoint data_select window=30
press A hold=10
wait 180
wait 120
wait 120
tap A times=20 every=40 hold=6
wait 30
tap A times=30 every=40 hold=6
wait 30
tap A times=20 every=40 hold=6
wait 30
checkpoint resumed window=30
