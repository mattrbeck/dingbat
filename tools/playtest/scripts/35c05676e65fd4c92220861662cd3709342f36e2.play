@title Klonoa 2 - Dream Champ Tournament (USA)
@file Klonoa 2 - Dream Champ Tournament (U).gba
@game AN6E
@chip EEPROM
@frozen dingbat-bios,mgba,nba

# NEW GAME, file 1, YES (the game writes the file to its 4Kbit EEPROM as soon
# as it is created, and again on entering Vision 1-1), skip the intro, world
# map west to Western Jungle, skip the story, Vision 1-1: Nagapoko's hint,
# grab a Moo, collect a gem, jump up the ledges, pause, Select Vision back to
# the vision map. [load]: the title adds CONTINUE, file 1 shows World 1
# Western Jungle, YES resumes on the Vision 1-1 map.
# Findings: dingbat used to run the game's loads fast -- the title's star
# a frame ahead of mgba and nba, the world map two, then from f4454 (the
# white mosaic fade-in to Vision 1-1) never matching either reference again
# (the fade a step on, the HUD hearts at another phase, Klonoa ~3 px left at
# gameplay), so level_start and gameplay failed in every dingbat
# configuration. The loads are Nintendo's HuffUnComp with the tree in the
# cartridge, and dingbat priced a lone byte load from the gamepak S when it
# read the halfword after the previous one, under the prefetcher; GBATEK and
# the ARM7TDMI make it N. Fixed (docs/playtest-bugs.md, "Klonoa 2"):
# dingbat-bios now differs from mgba on no frame where mgba and nba agree
# (f700-f5300). dingbat's own saves load in mgba and nba.
# Elsewhere the references disagree with each other
# (backgrounds scroll at different phases on the file select and vision map).
# nba does not read back its own 8 KB battery file: on [load] its title has
# no CONTINUE (f1226) and its file 1 is NO DATA, so it starts a new game.
[new]
wait 600
wait 300
wait 200
checkpoint title window=30
press START
wait 120
wait 60
press A
wait 180
checkpoint save_file window=30
press A
wait 180
press A
wait 180
press START
wait 240
checkpoint world_map window=30
press A
wait 180
press LEFT
wait 120
press A
wait 180
wait 60
wait 60
press START
wait 240
wait 60
wait 180
press A
wait 180
checkpoint vision_map window=30
press A
wait 240
wait 60
press A
wait 120
# mash A until notext Hint timeout=1500 every=30  [taps dingbat-bios:11 mgba:11 nba:11]
tap A times=11 every=30 hold=4
wait 120
wait 120
wait 120
checkpoint level_start window=30
press RIGHT hold=60
press B
wait 30
press LEFT hold=40
press RIGHT hold=120
hold RIGHT
press A hold=20
wait 40
release
wait 30
checkpoint gameplay window=30
press RIGHT hold=60
hold RIGHT
press A hold=25
wait 50
release
wait 30
press START
wait 40
checkpoint pause window=30 compare=text
press DOWN after=10
press DOWN after=10
press A
wait 300
checkpoint back_to_map window=30

[load]
wait 1100
press START
wait 120
checkpoint continue_menu window=30 compare=text
press DOWN after=10
press A
wait 180
checkpoint save_file window=30 compare=text
press A
wait 180
press A
wait 300
checkpoint resumed_map window=30
