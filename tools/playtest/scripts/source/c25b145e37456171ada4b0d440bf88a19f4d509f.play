@title Fire Emblem: The Sacred Stones (USA)
@file Fire Emblem - The Sacred Stones (U).gba
@game BE8E
@chip SRAM_F (FRAM)

# New Game on Normal into the first slot, skip the opening, skip the Prologue
# cutscenes with START until the first Player Phase: the chapter slot and the
# suspend data are both written by then. [load] takes Resume Chapter back onto
# the Prologue map.

[new]
wait 600
mash A until text "START" timeout=1500 every=30
wait 60
checkpoint title window=30
press START
until text "Extras" timeout=600 every=10
wait 60
press A
until text "Select Mode" timeout=300 every=5
wait 30
checkpoint select_mode window=30
press DOWN after=20
press A
until text "NO DATA" timeout=300 every=5
wait 30
checkpoint slots_empty window=30
press A
until text "age long past" timeout=900 every=10
checkpoint intro window=30
press START
wait 180
press START
until text "Prologue" timeout=900 every=10
wait 20
checkpoint prologue window=30 compare=text
mash START until text "PHASE" timeout=3000 every=10
until notext "PHASE" timeout=300 every=5
wait 30
checkpoint player_phase window=30 compare=text

[load]
wait 600
mash A until text "START" timeout=1500 every=30
wait 60
press START
until text "Resume Chapter" timeout=600 every=10
wait 60
checkpoint main_menu window=30 compare=text
press A
until text "Renais" timeout=300 every=5
wait 30
checkpoint slot_prologue window=30
press A
until text "Plain" timeout=900 every=10
wait 60
checkpoint resumed_map window=30 compare=text
