@title Golden Sun (USA, Europe)
@file Golden Sun (UE) [!].gba
@game AGSE
@chip FLASH
@frozen dingbat-bios,mgba,nba

# With no save the game goes straight to naming Isaac; keep the default name,
# mash A through the storm intro until Isaac is free in Vale (the A mash ends
# by opening the field menu), then save to the first slot from the START menu.
[new]
# until text DEL timeout=1800 every=10  [reached dingbat-bios+480 mgba+470 nba+480]
wait 484
wait 30
checkpoint naming window=10
press A
# until text 'wake up' timeout=900 every=10  [reached dingbat-bios+140 mgba+140 nba+150]
wait 154
checkpoint wake_up window=0
# mash A until text Psynergy timeout=9000 every=30  [taps dingbat-bios:130 mgba:130 nba:130]
tap A times=130 every=30 hold=4
wait 10
checkpoint field_menu window=0
press B after=40
press START
# until text 'Save your quest' timeout=120 every=5  [reached dingbat-bios+0 mgba+0 nba+0]
wait 4
wait 20
checkpoint pause_menu window=0
press A
# until text 'saved data' timeout=300 every=5  [reached dingbat-bios+10 mgba+10 nba+10]
wait 14
wait 20
checkpoint slots window=0
press A
# until text aving timeout=120 every=2  [reached dingbat-bios+8 mgba+8 nba+10]
wait 14
# until notext aving timeout=900 every=5  [reached dingbat-bios+30 mgba+40 nba+30]
wait 44
wait 10
checkpoint saved window=0

[load]
# until text CAMELOT timeout=1800 every=10  [reached dingbat-bios+580 mgba+590 nba+580]
wait 594
wait 200
press START
# until text Continue timeout=900 every=10  [reached dingbat-bios+150 mgba+150 nba+150]
wait 154
wait 20
checkpoint continue_menu window=0
press A
# until text 'Play Time' timeout=300 every=5  [reached dingbat-bios+10 mgba+10 nba+15]
wait 19
wait 20
checkpoint slot_select window=0
press A
# until notblank timeout=600 every=10  [reached dingbat-bios+0 mgba+0 nba+0]
wait 4
wait 300
checkpoint resumed window=0
press START
# until text 'Save your quest' timeout=120 every=5  [reached dingbat-bios+0 mgba+0 nba+0]
wait 4
wait 20
checkpoint resumed_menu window=0
