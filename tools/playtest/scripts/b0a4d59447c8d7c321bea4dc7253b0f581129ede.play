@title Donkey Kong Country 2 (USA)
@file Donkey Kong Country 2 (U).gba
@game B2DE
@chip EEPROM
@frozen dingbat-bios,mgba,nba

# Start, save slot 1, 1-Player, name AAA, skip the opening, then save from
# the pause screen on the Gangplank Galleon map ("Save Game? Yes"). [load]
# picks the filled slot and returns to the map; the pause screen shows AAA.
[new]
# mash START until text Games timeout=1500 every=60  [taps dingbat-bios:25 mgba:25 nba:25]
tap START times=25 every=60 hold=4
wait 30
checkpoint main_menu window=30 compare=text
press A
# until text SLOT timeout=900 every=10  [reached dingbat-bios+140 mgba+140 nba+140]
wait 144
wait 30
checkpoint slots window=30
press A
# until text Tea timeout=900 every=10  [reached dingbat-bios+90 mgba+90 nba+100]
wait 104
wait 30
checkpoint player_select window=30 compare=text
press A
# until text END timeout=900 every=10  [reached dingbat-bios+90 mgba+90 nba+90]
wait 94
wait 60
checkpoint name_entry window=10
press A after=20
press A after=20
press A after=40
checkpoint name_aaa window=10
press A
# mash START until text 'Save Game' timeout=4000 every=60  [taps dingbat-bios:9 mgba:9 nba:9]
tap START times=9 every=60 hold=4
wait 30
checkpoint pause_stats window=30
press A
wait 60
checkpoint save_prompt window=10
press A
# until text Saving timeout=300 every=5  [reached dingbat-bios+15 mgba+15 nba+15]
wait 19
# until text Successful timeout=900 every=10  [reached dingbat-bios+150 mgba+150 nba+160]
wait 164
checkpoint saved window=10

[load]
# mash START until text Games timeout=1500 every=60  [taps dingbat-bios:23 mgba:23 nba:23]
tap START times=23 every=60 hold=4
wait 30
checkpoint main_menu window=30 compare=text
press A
# until text SLOT timeout=900 every=10  [reached dingbat-bios+140 mgba+140 nba+140]
wait 144
wait 30
checkpoint slots window=30
press A
# until text plank timeout=1500 every=10  [reached dingbat-bios+230 mgba+230 nba+230]
wait 234
wait 60
checkpoint map window=30 compare=text
press START
# until text 'Save Game' timeout=300 every=10  [reached dingbat-bios+80 mgba+80 nba+80]
wait 84
wait 30
checkpoint pause_stats window=30
