@title The Legend of Zelda - The Minish Cap (USA)
@file Legend of Zelda, The - The Minish Cap (U).gba
@game BZME
@chip EEPROM
@frozen dingbat-bios,mgba,nba

# File 1 named AA: the game writes the new file as soon as the name is
# confirmed ("Saving file..."), then returns to the file select.
[new]
# until text Minish timeout=1800 every=10  [reached dingbat-bios+360 mgba+360 nba+360]
wait 364
# until text 'PRESS START' timeout=900 every=5  [reached dingbat-bios+350 mgba+350 nba+350]
wait 354
wait 20
checkpoint title window=0
press START
# until text 'CHOOSE A FILE' timeout=600 every=10  [reached dingbat-bios+40 mgba+40 nba+40]
wait 44
wait 60
checkpoint file_select_empty window=0
press A
# until text 'ENTER A NAME' timeout=600 every=10  [reached dingbat-bios+10 mgba+10 nba+10]
wait 14
wait 60
checkpoint naming window=0
press A after=20
press A after=20
press START after=20
checkpoint name_typed window=0
press A
# until text 'Saving file' timeout=300 every=5  [reached dingbat-bios+0 mgba+0 nba+0]
wait 4
checkpoint saving window=0
# until notext Saving timeout=900 every=5  [reached dingbat-bios+235 mgba+245 nba+230]
wait 249
# until text 'CHOOSE A FILE' timeout=600 every=10  [reached dingbat-bios+0 mgba+0 nba+0]
wait 4
wait 60
checkpoint saved window=0

[load]
# until text Minish timeout=1800 every=10  [reached dingbat-bios+350 mgba+350 nba+350]
wait 354
# until text 'PRESS START' timeout=900 every=5  [reached dingbat-bios+350 mgba+350 nba+350]
wait 354
wait 20
press START
# until text 'CHOOSE A FILE' timeout=600 every=10  [reached dingbat-bios+40 mgba+40 nba+40]
wait 44
# until text AA timeout=300 every=5  [reached dingbat-bios+40 mgba+15 nba+20]
wait 44
wait 60
checkpoint file_select_saved window=0
press A
# until text START timeout=300 every=5  [reached dingbat-bios+5 mgba+5 nba+5]
wait 9
wait 30
checkpoint file_menu window=0
press A
# until text long timeout=900 every=10  [reached dingbat-bios+380 mgba+380 nba+380]
wait 384
wait 60
checkpoint story_intro window=0
