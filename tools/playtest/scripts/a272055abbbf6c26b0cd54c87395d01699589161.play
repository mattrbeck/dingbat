@title The Legend of Zelda: A Link to the Past & Four Swords (USA)
@file Legend of Zelda, The - A Link To The Past Four Swords (U) [!].gba
@game AZLE
@chip EEPROM
@frozen dingbat-bios,mgba,nba

# Registering a name on file 1 writes the file ("Now saving..."); [load]
# shows file 1 with its name, hearts and the OPTIONS button, then picks
# A Link to the Past through its title into the opening story.
[new]
# until text 'CHOOSE A FILE' timeout=900 every=10  [reached dingbat-bios+360 mgba+360 nba+360]
wait 364
wait 150
press A
# until text 'ENTER A NAME' timeout=300 every=5  [reached dingbat-bios+30 mgba+30 nba+35]
wait 39
wait 30
press A after=20
press START after=60
checkpoint name_entry window=30 compare=text
press A
# until text 'Now saving' timeout=300 every=2  [reached dingbat-bios+0 mgba+0 nba+0]
wait 4
checkpoint saving window=30 compare=text
# until notext saving timeout=900 every=5  [reached dingbat-bios+5 mgba+5 nba+5]
wait 9
# until text 'CHOOSE A FILE' timeout=600 every=5  [reached dingbat-bios+35 mgba+35 nba+35]
wait 39
wait 30
checkpoint file_saved window=30 compare=text

[load]
# until text 'CHOOSE A FILE' timeout=900 every=10  [reached dingbat-bios+350 mgba+350 nba+350]
wait 354
# until text OPTIONS timeout=600 every=5  [reached dingbat-bios+75 mgba+75 nba+75]
wait 79
wait 30
checkpoint file_loaded window=30 compare=text
press A
# until text Four timeout=300 every=5  [reached dingbat-bios+120 mgba+120 nba+120]
wait 124
wait 30
press A
wait 300
# until text 2002 timeout=900 every=10  [reached dingbat-bios+290 mgba+290 nba+290]
wait 294
wait 30
checkpoint alttp_title window=30
# mash START until text Hyrule timeout=1200 every=60  [taps dingbat-bios:5 mgba:5 nba:5]
tap START times=5 every=60 hold=4
wait 20
checkpoint story window=30 compare=text
