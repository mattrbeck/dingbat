@title Final Fight One (USA)
@file Final Fight One (U).gba
@game AFFE
@chip EEPROM
@frozen dingbat-bios,mgba,nba

# Options: Difficulty EASY, Exit (Battle Point result screen), Game
# Start > Guy, fight through the first half of Round 1 (one life lost),
# pause once. The game keeps options, battle points and a resume point in
# EEPROM. [load]: the BACK UP DATA prompt ("resume the game?") comes up
# before the intro; YES resumes Round 1 with Guy.
# Session notes: in the intro story (f600-f780, checkpoint intro_story)
# dingbat-bios draws the caption box under the map black, mgba and nba
# draw it solid blue. nba draws a few fight frames differently late in
# the round (f3847 enemy pose, f7719 another enemy and a half-drawn name
# plate), score and lives agree.
# Save size: dingbat-bios and mgba write 512 bytes, nba 8 KB (same first
# 512 bytes). Load: nba booted with its own 8 KB file shows no BACK UP
# DATA prompt and plays the intro as on a blank cart (f660), so its
# [load] presses go to the intro instead.

[new]
wait 600
checkpoint intro_story window=30
wait 120
press START
wait 120
wait 60
press START
wait 90
checkpoint mode_select window=30
press DOWN
wait 15
press DOWN
wait 15
press A
wait 60
press LEFT
wait 20
press A
wait 15
press LEFT
wait 15
press A
wait 15
checkpoint options_easy window=30
press B
wait 60
press R
wait 60
tap DOWN times=6 every=15 hold=4
wait 10
press A
wait 90
checkpoint battle_points window=30
press A
wait 90
press UP
wait 15
press UP
wait 15
press A
wait 90
checkpoint player_select window=30
press A
wait 300
wait 300
checkpoint stage1 window=30
tap B times=30 every=8 hold=4
press RIGHT hold=40
tap B times=30 every=8 hold=4
press RIGHT hold=60
tap B times=30 every=8 hold=4
press RIGHT hold=60
tap B times=30 every=8 hold=4
tap B times=30 every=8 hold=4
press RIGHT hold=60
tap B times=30 every=8 hold=4
press START
wait 30
checkpoint paused window=30
press START
wait 10
tap B times=40 every=8 hold=4
press RIGHT hold=60
tap B times=40 every=8 hold=4
press RIGHT hold=60
tap B times=40 every=8 hold=4
press RIGHT hold=60
tap B times=40 every=8 hold=4
press RIGHT hold=60
tap B times=40 every=8 hold=4
tap B times=30 every=8 hold=4
press RIGHT hold=60
tap B times=40 every=8 hold=4
press RIGHT hold=60
tap B times=40 every=8 hold=4
press RIGHT hold=60
tap B times=40 every=8 hold=4
checkpoint stage1_late window=30

[load]
wait 600
checkpoint resume_prompt window=30
press LEFT
wait 15
press A
wait 240
wait 240
checkpoint resumed window=30
wait 240
checkpoint resumed_play window=30
