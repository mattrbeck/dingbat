[load]
wait 600
# until notblank timeout=1200 every=10  [reached dingbat-bios+0 mgba+0 nba+0]
wait 4
# mash START until text START timeout=1200 every=30  [taps dingbat-bios:2 mgba:2 nba:2]
tap START times=2 every=30 hold=4
press START
# until text 'SAMUS DATA' timeout=900 every=10  [reached dingbat-bios+60 mgba+60 nba+70]
wait 74
wait 30
checkpoint file_select_saved window=0 compare=text
press A after=60
wait 30
checkpoint file_menu window=0 compare=text
press A
wait 400
checkpoint resumed window=30

