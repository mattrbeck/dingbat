@title Golden Sun - The Lost Age (USA, Europe)
@file Golden Sun - The Lost Age (UE) [!].gba
@game AGFE
@chip FLASH

# With no save the game names Felix, asks whether to transfer data from
# Golden Sun (No), names Isaac, then plays the story recap (START skips it).
# Mash A through the opening until the party is free on Venus Lighthouse (the A
# mash ends by opening the field menu), close the menu and save to the first
# slot from the START menu.

[new]
until text "DEL" timeout=1800 every=10
wait 30
checkpoint naming window=10
press A
until text "Golden Sun" timeout=900 every=10
wait 20
press RIGHT after=30
checkpoint transfer window=0
press A
until text "Isaac" timeout=900 every=10
wait 60
press A
until text "Ages ago" timeout=900 every=10
wait 60
press START
until text "Camelot presents" timeout=1200 every=10
checkpoint presents window=0
mash A until text "Psynergy" timeout=15000 every=30
wait 10
checkpoint field_menu window=0
press B after=40
press B after=40
wait 40
press START
until text "Save your quest" timeout=120 every=5
wait 20
checkpoint pause_menu window=0
press A
until text "saved data" timeout=300 every=5
wait 20
checkpoint slots window=0
press A
until text "aving" timeout=120 every=2
until notext "aving" timeout=900 every=5
wait 10
checkpoint saved window=0

[load]
until text "CAMELOT" timeout=1800 every=10
wait 200
press START
until text "PRESS" timeout=900 every=10
wait 10
press START
until text "Continue" timeout=900 every=10
wait 20
checkpoint continue_menu window=0 compare=text
press A
until text "Play Time" timeout=300 every=5
wait 20
checkpoint slot_select window=0
press A
until notblank timeout=600 every=10
wait 300
checkpoint resumed window=0
press START
until text "Save your quest" timeout=120 every=5
wait 20
checkpoint resumed_menu window=0
