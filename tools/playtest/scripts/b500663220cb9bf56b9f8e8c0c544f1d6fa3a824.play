@title Golden Sun - The Lost Age (USA, Europe)
@file Golden Sun - The Lost Age (UE) [!].gba
@game AGFE
@chip FLASH
@frozen dingbat-bios,mgba,nba

# With no save the game names Felix, asks whether to transfer data from
# Golden Sun (No), names Isaac, then plays the story recap (START skips it).
# Mash A through the opening until the party is free on Venus Lighthouse (the A
# mash ends by opening the field menu), close the menu and save to the first
# slot from the START menu.
[new]
# until text DEL timeout=1800 every=10  [reached dingbat-bios+530 mgba+520 nba+540]
wait 544
wait 30
checkpoint naming window=10
press A
# until text 'Golden Sun' timeout=900 every=10  [reached dingbat-bios+30 mgba+30 nba+30]
wait 34
wait 20
press RIGHT after=30
checkpoint transfer window=0
press A
# until text Isaac timeout=900 every=10  [reached dingbat-bios+40 mgba+40 nba+40]
wait 44
wait 60
press A
# until text 'Ages ago' timeout=900 every=10  [reached dingbat-bios+330 mgba+330 nba+340]
wait 344
wait 60
press START
# until text 'Camelot presents' timeout=1200 every=10  [reached dingbat-bios+520 mgba+520 nba+520]
wait 524
checkpoint presents window=0
# mash A until text Psynergy timeout=15000 every=30  [taps dingbat-bios:364 mgba:364 nba:364]
tap A times=364 every=30 hold=4
wait 10
checkpoint field_menu window=0
press B after=40
press B after=40
wait 40
press START
# until text 'Save your quest' timeout=120 every=5  [reached dingbat-bios+0 mgba+0 nba+0]
wait 4
wait 20
checkpoint pause_menu window=0
press A
# until text 'saved data' timeout=300 every=5  [reached dingbat-bios+15 mgba+15 nba+15]
wait 19
wait 20
checkpoint slots window=0
press A
# until text aving timeout=120 every=2  [reached dingbat-bios+8 mgba+8 nba+8]
wait 12
# until notext aving timeout=900 every=5  [reached dingbat-bios+45 mgba+60 nba+50]
wait 64
wait 10
checkpoint saved window=0

[load]
# until text CAMELOT timeout=1800 every=10  [reached dingbat-bios+520 mgba+520 nba+520]
wait 524
wait 200
press START
# until text PRESS timeout=900 every=10  [reached dingbat-bios+180 mgba+180 nba+170]
wait 184
wait 10
press START
# until text Continue timeout=900 every=10  [reached dingbat-bios+150 mgba+150 nba+160]
wait 164
wait 20
checkpoint continue_menu window=0 compare=text
press A
# until text 'Play Time' timeout=300 every=5  [reached dingbat-bios+15 mgba+15 nba+15]
wait 19
wait 20
checkpoint slot_select window=0
press A
# until notblank timeout=600 every=10  [reached dingbat-bios+0 mgba+0 nba+0]
wait 4
wait 300
checkpoint resumed window=0
press START
# until text 'Save your quest' timeout=120 every=5  [reached dingbat-bios+0 mgba+0 nba+0]
wait 4
wait 20
checkpoint resumed_menu window=0
