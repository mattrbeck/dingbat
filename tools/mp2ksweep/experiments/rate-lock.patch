           s.tap_i = 0xFFFFFFFF'u32
           s.ended = false
           s.blk_index = 0xFFFFFFFF'u32
+          s.lock_k = -1
+        # Rate lock. The driver steps a voice by a fixed-point figure it
+        # derives from freq and pcmFreq, which is not freq / pcmFreq exactly:
+        # Disney Sports American Football's 21024 Hz voice advances exactly
+        # 352 source samples a pass at 18157 Hz where the ratio gives
+        # 351.9995, and the free-running cursor gained 0.07 samples every 40
+        # passes, a waveform drift of 3 output samples in 12 s. From its
+        # 16th pass a note plays at the rate its engine positions have
+        # averaged since the lock began. A position that went backward (a
+        # loop wrap), a snap, or a new frequency starts the lock again.
+        if not s.reversed and s.lock_k >= 0 and engine_pos >= s.lock_prev and p.freq == s.lock_freq:
+          inc s.lock_k
+          s.lock_rate = float64(engine_pos - s.lock_e0) / float64(s.lock_k)
+        elif not s.reversed:
+          s.lock_k = 0
+          s.lock_e0 = engine_pos
+          s.lock_freq = p.freq
+        else:
+          s.lock_k = -1
+        s.lock_prev = engine_pos
+      else:
+        s.lock_k = -1
     s.wave_data   = new_wave_data
     s.compressed  = compressed
     s.reversed    = reversed
