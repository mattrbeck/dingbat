# Built engine runners: they link against out-of-tree SameBoy and DocBoy
# checkouts under <worktree>/.scratch, which build.sh creates.
bin/
# Assembler intermediates and shot output. The probe .gb and .sym files
# themselves ARE committed -- they are the artifact that goes to hardware.
build/
out/
# The optional second burn, for page 33 only (see README, "One ROM for the
# flashcart"): GBPROBE_CGB=0 ./build.sh probes_all rebuilds it in seconds.
probes_all_compat.gb
probes_all_compat.sym
