; A 16-glyph hex font, and the routine that paints a nibble with it.
;
; The numeric probes store raw bytes to WRAM and ALSO render them on screen,
; because the permanent job of these ROMs is to be photographed on real
; hardware, where WRAM is not readable. Hex digits are the whole alphabet:
; every label a probe needs is a number, so the font is 16 tiles and no more.
;
; Glyphs are 5x7 in an 8x8 cell, colour index 3 on index 0, which reads
; cleanly off a phone camera pointed at a DMG screen.

IF !DEF(FONT_INC)
DEF FONT_INC EQU 1

; Tile $00 is blank; digit d lives at tile $10 + d.
DEF FONT_BASE EQU $10

FontTiles:
    ; 0
    dw `00333000, `03000300, `03000300, `03000300, `03000300, `03000300, `00333000, `00000000
    ; 1
    dw `00033000, `00303000, `00003000, `00003000, `00003000, `00003000, `00333300, `00000000
    ; 2
    dw `00333000, `03000300, `00000300, `00003000, `00030000, `00300000, `03333300, `00000000
    ; 3
    dw `03333000, `00000300, `00000300, `00333000, `00000300, `00000300, `03333000, `00000000
    ; 4
    dw `00000300, `00003300, `00030300, `00300300, `03333330, `00000300, `00000300, `00000000
    ; 5
    dw `03333300, `03000000, `03333000, `00000300, `00000300, `03000300, `00333000, `00000000
    ; 6
    dw `00033000, `00300000, `03000000, `03333000, `03000300, `03000300, `00333000, `00000000
    ; 7
    dw `03333300, `00000300, `00003000, `00030000, `00300000, `00300000, `00300000, `00000000
    ; 8
    dw `00333000, `03000300, `03000300, `00333000, `03000300, `03000300, `00333000, `00000000
    ; 9
    dw `00333000, `03000300, `03000300, `00333300, `00000300, `00003000, `00330000, `00000000
    ; A
    dw `00333000, `03000300, `03000300, `03333300, `03000300, `03000300, `03000300, `00000000
    ; B
    dw `03333000, `03000300, `03333000, `03000300, `03000300, `03000300, `03333000, `00000000
    ; C
    dw `00333000, `03000300, `03000000, `03000000, `03000000, `03000300, `00333000, `00000000
    ; D
    dw `03330000, `03003000, `03000300, `03000300, `03000300, `03003000, `03330000, `00000000
    ; E
    dw `03333300, `03000000, `03000000, `03333000, `03000000, `03000000, `03333300, `00000000
    ; F
    dw `03333300, `03000000, `03000000, `03333000, `03000000, `03000000, `03000000, `00000000
FontTilesEnd:

DEF FONT_TILE_BYTES EQU FontTilesEnd - FontTiles

ENDC
