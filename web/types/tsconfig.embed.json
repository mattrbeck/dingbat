{
  // Typecheck project for embed.html's script tags (glpresent.js + embed.js;
  // embed.html does not load sdputil.js or netplay.js).
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "types": []
  },
  "files": [
    "em.d.ts",
    "globals.d.ts",
    "../glpresent.js",
    "../embed.js"
  ]
}
